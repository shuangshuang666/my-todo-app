rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      let requiredFields = ['isAnonymous'];
      return data.keys().hasAll(requiredFields) &&
             data.isAnonymous is bool &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000000)) &&
             (!('lastVisit' in data) || (data.lastVisit is string)) &&
             (!('streakCount' in data) || (data.streakCount is int && data.streakCount >= 0)) &&
             (!('remindersEnabled' in data) || (data.remindersEnabled is bool)) &&
             (!('dailyReminderTime' in data) || (data.dailyReminderTime is string && data.dailyReminderTime.size() <= 10));
    }

    function isValidHabit(data) {
      let requiredFields = ['name', 'frequency', 'userId', 'isActive', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.frequency in ['daily', 'weekly'] &&
             data.userId == request.auth.uid &&
             data.isActive is bool &&
             data.createdAt is string &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 50)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 1000)) &&
             (!('color' in data) || (data.color is string && data.color.size() <= 20)) &&
             (!('reminderTime' in data) || (data.reminderTime is string && data.reminderTime.size() <= 10));
    }

    function isValidHistory(data) {
      let requiredFields = ['habitId', 'userId', 'date', 'status', 'timestamp'];
      return data.keys().hasAll(requiredFields) &&
             data.habitId is string && data.habitId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.status in ['done', 'pending'] &&
             data.timestamp is string;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastVisit', 'streakCount', 'remindersEnabled', 'dailyReminderTime']);
    }

    match /habits/{habitId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidHabit(incoming());
      allow update: if isOwner(existing().userId) && isValidHabit(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'color', 'details', 'frequency', 'reminderTime', 'isActive']);
      allow delete: if isOwner(existing().userId);
    }

    match /history/{recordId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidHistory(incoming()) && 
                    existsAfter(/databases/$(database)/documents/habits/$(incoming().habitId)) &&
                    getAfter(/databases/$(database)/documents/habits/$(incoming().habitId)).data.userId == request.auth.uid;
      allow update: if isOwner(existing().userId) && isValidHistory(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timestamp']);
      allow delete: if isOwner(existing().userId);
    }
  }
}
